---
interface Props {
  pagina: string;
  parent?: string;
  parentHref?: string;
}

const { pagina, parent, parentHref } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://www.alexavolt.ro';

// Build BreadcrumbList JSON-LD
const items: Array<{ "@type": string; position: number; name: string; item?: string }> = [
  { "@type": "ListItem", position: 1, name: "Acasă", item: `${siteUrl}/` }
];

if (parent && parentHref) {
  const parentUrl = parentHref.startsWith('http') ? parentHref : `${siteUrl}${parentHref}`;
  items.push({ "@type": "ListItem", position: 2, name: parent, item: parentUrl });
  items.push({ "@type": "ListItem", position: 3, name: pagina });
} else {
  items.push({ "@type": "ListItem", position: 2, name: pagina });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items
};
---

<nav class="mb-8 flex flex-wrap items-center gap-2 text-sm font-bold" aria-label="Breadcrumb">
  <a href={`${base}/`} class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-blue-100 hover:text-blue-600 transition-all">
    🏠 Acasă
  </a>
  {parent && parentHref && (
    <>
      <span class="text-slate-300">›</span>
      <a href={parentHref} class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-blue-100 hover:text-blue-600 transition-all">
        {parent}
      </a>
    </>
  )}
  <span class="text-slate-300">›</span>
  <span class="px-3 py-1.5 rounded-lg bg-blue-600 text-white shadow-sm">
    {pagina}
  </span>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
