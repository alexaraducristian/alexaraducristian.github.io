---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Instalații Electrice Complete Iași — Case Noi și Renovări | AlexaVolt" description="Instalații electrice complete pentru case noi și renovări în Iași. Proiectare conformă I7, execuție autorizată ANRE, materiale premium Schneider. Deviz gratuit.">
  <Header />

  <main class="max-w-5xl mx-auto px-6 py-12 font-sans text-slate-800">

    <Breadcrumb pagina="Instalații Electrice Complete" parent="🛠️ Servicii" parentHref={`${base}/servicii/`} />

    <section class="mb-16 border-b border-slate-100 pb-12">
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-6 leading-tight">
        Instalații Electrice Complete Iași — <span class="text-emerald-600">Case Noi și Renovări</span>
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed max-w-3xl">
        Proiectăm și executăm instalația electrică completă pentru locuința ta — de la tabloul electric până la ultima priză. Lucrăm exclusiv conform normativului I7, cu materiale premium și autorizare ANRE.
      </p>
      <div class="mt-6 flex flex-wrap gap-3 text-sm font-semibold text-slate-700">
        <span class="bg-blue-50 border border-blue-200 px-4 py-2 rounded-full">✓ Autorizare ANRE</span>
        <span class="bg-blue-50 border border-blue-200 px-4 py-2 rounded-full">✓ Normativ I7</span>
        <span class="bg-blue-50 border border-blue-200 px-4 py-2 rounded-full">✓ Garanție 2 ani</span>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span>🏗️</span> Ce include o instalație electrică completă?
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100">
          <h3 class="font-bold text-blue-700 mb-3">Faza de proiectare</h3>
          <ul class="space-y-2 text-sm text-slate-600">
            <li class="flex gap-2"><span class="text-emerald-600">✓</span> Schema electrică pe planul arhitectural</li>
            <li class="flex gap-2"><span class="text-emerald-600">✓</span> Dimensionarea circuitelor și protecțiilor</li>
            <li class="flex gap-2"><span class="text-emerald-600">✓</span> Alegerea secțiunilor de cablu conform I7</li>
            <li class="flex gap-2"><span class="text-emerald-600">✓</span> Plan de prize, întrerupătoare și iluminat</li>
          </ul>
        </div>
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100">
          <h3 class="font-bold text-blue-700 mb-3">Faza de execuție</h3>
          <ul class="space-y-2 text-sm text-slate-600">
            <li class="flex gap-2"><span class="text-emerald-600">✓</span> Trasare și montaj tuburi protecție (copex/tub rigid)</li>
            <li class="flex gap-2"><span class="text-emerald-600">✓</span> Tragere cabluri NYM/CYY cu secțiune corectă</li>
            <li class="flex gap-2"><span class="text-emerald-600">✓</span> Montaj tablou electric complet echipat</li>
            <li class="flex gap-2"><span class="text-emerald-600">✓</span> Testare și buletin PRAM la finalizare</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span>🔧</span> Tipuri de proiecte pe care le realizăm
      </h2>
      <div class="space-y-4">
        <div class="bg-blue-50 p-6 rounded-2xl border border-blue-100">
          <h3 class="font-bold text-slate-900 mb-2">Case și vile noi</h3>
          <p class="text-sm text-slate-600">Instalație completă de la zero — proiectare personalizată pe planul arhitectural, execuție la roșu și finisaj. Include circuite dedicate pentru AC, plită inductie, boiler, mașina de spălat și încărcare EV.</p>
        </div>
        <div class="bg-blue-50 p-6 rounded-2xl border border-blue-100">
          <h3 class="font-bold text-slate-900 mb-2">Renovări și modernizări</h3>
          <p class="text-sm text-slate-600">Înlocuim instalația veche de aluminiu cu cupru dimensionat corect. Adăugăm circuite noi, schimbăm tabloul electric și aducem instalația la standarde actuale de siguranță.</p>
        </div>
        <div class="bg-blue-50 p-6 rounded-2xl border border-blue-100">
          <h3 class="font-bold text-slate-900 mb-2">Spații comerciale și birouri</h3>
          <p class="text-sm text-slate-600">Instalații electrice pentru magazine, clinici, birouri și alte spații comerciale. Proiectare conform cerințelor PSI și normativelor specifice.</p>
        </div>
      </div>
    </section>

    <section class="mb-16 bg-red-50 border border-red-100 p-8 rounded-3xl">
      <h2 class="text-2xl font-bold text-red-800 mb-4">⚠️ De ce contează execuția autorizată?</h2>
      <p class="text-slate-700 mb-4">O instalație executată de personal necalificat te expune la riscuri grave:</p>
      <ul class="space-y-3 text-slate-700">
        <li class="flex gap-3"><span class="text-red-600 font-bold">•</span> <strong>Risc de incendiu</strong> — secțiuni subdimensionate care se supraîncălzesc</li>
        <li class="flex gap-3"><span class="text-red-600 font-bold">•</span> <strong>Risc de electrocutare</strong> — lipsa protecțiilor diferențiale (RCD)</li>
        <li class="flex gap-3"><span class="text-red-600 font-bold">•</span> <strong>Asigurarea invalidată</strong> — asigurătorul refuză despăgubirea</li>
        <li class="flex gap-3"><span class="text-red-600 font-bold">•</span> <strong>Imposibilitate vânzare</strong> — fără buletin PRAM valid</li>
      </ul>
    </section>

    <section class="mb-16 bg-slate-50 p-6 rounded-2xl border border-slate-100">
      <h2 class="text-xl font-bold text-slate-900 mb-4">📖 Articole utile</h2>
      <ul class="space-y-2">
        <li><a href={`${base}/articole/cat-costa-instalatie-electrica-casa/`} class="text-blue-600 font-semibold hover:text-blue-800 transition-colors">Cât costă o instalație electrică pentru casă →</a></li>
        <li><a href={`${base}/articole/cabluri-nym-cyy-fy/`} class="text-blue-600 font-semibold hover:text-blue-800 transition-colors">Ghid cabluri NYM, CYY, FY — ce alegi →</a></li>
        <li><a href={`${base}/articole/checklist-electric-locuinta-noua/`} class="text-blue-600 font-semibold hover:text-blue-800 transition-colors">Checklist electric pentru locuința nouă →</a></li>
        <li><a href={`${base}/articole/deviz-instalatie-electrica/`} class="text-blue-600 font-semibold hover:text-blue-800 transition-colors">Cum arată un deviz de instalație electrică →</a></li>
      </ul>
    </section>

    <section class="text-center border-t border-slate-100 pt-12">
      <h2 class="text-2xl font-bold mb-4 text-slate-900">Ai nevoie de instalație electrică?</h2>
      <p class="text-slate-600 mb-8 max-w-2xl mx-auto">Contactează-ne pentru o evaluare gratuită la domiciliu. Primești deviz detaliat cu materiale și manoperă în 24-48 ore.</p>
      <a href={`${base}/contact/`} class="inline-block bg-blue-600 text-white px-10 py-4 rounded-full text-lg font-bold hover:bg-blue-700 transition-all shadow-xl hover:-translate-y-1">
        Solicită deviz gratuit
      </a>
      <p class="mt-4 text-sm text-slate-500">✓ Evaluare fără obligații · ✓ Răspuns în max. 2 ore</p>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Instalații electrice complete",
    "provider": {
      "@type": "Electrician",
      "name": "AlexaVolt",
      "telephone": "+40745539432",
      "url": "https://www.alexavolt.ro"
    },
    "areaServed": {"@type": "City", "name": "Iași"},
    "description": "Proiectare și execuție instalații electrice complete pentru case noi, renovări și spații comerciale în Iași. Autorizare ANRE, materiale premium Schneider."
  })} />
</Layout>
