---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="AlexaVolt | Electrician Autorizat ANRE Iași — Instalații Electrice Profesionale" description="Cauți un electrician autorizat în Iași? AlexaVolt oferă servicii complete de instalații electrice, tablouri Schneider și sisteme fotovoltaice pentru rezidențial și firme. Solicită deviz gratuit.">
	<Header />
	
	<main class="max-w-4xl mx-auto px-6 py-12 font-sans text-slate-800">
		
		<section class="mb-16 border-b border-slate-100 pb-12">
			<h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-6 leading-tight">
				Electrician Autorizat ANRE Iași — <span class="text-emerald-600">Instalații Electrice</span> Profesionale
			</h1>
			<p class="text-lg md:text-xl leading-relaxed text-slate-600">
				<span class="font-bold text-slate-900">AlexaVolt</span> — electricieni autorizați ANRE din Iași. Instalații electrice complete, tablouri Schneider și sisteme fotovoltaice. Materiale premium, garanție 2 ani.
			</p>
			<div class="mt-6 flex flex-wrap gap-3 text-sm font-semibold text-slate-700">
				<span class="bg-blue-50 border border-blue-200 px-4 py-2 rounded-full">✓ Autorizare ANRE</span>
				<span class="bg-blue-50 border border-blue-200 px-4 py-2 rounded-full">✓ Normativ I7</span>
				<span class="bg-blue-50 border border-blue-200 px-4 py-2 rounded-full">✓ Schneider Electric</span>
				<span class="bg-blue-50 border border-blue-200 px-4 py-2 rounded-full">✓ Garanție 2 ani</span>
			</div>
		</section>

		<section class="mb-16">
			<h2 class="text-3xl font-bold mb-8 text-slate-900">
				🛠️ Servicii
			</h2>

			<div class="grid gap-6 md:grid-cols-2">
				<a href={`${base}/servicii/instalatii-electrice-complete/`} class="group bg-slate-50 p-6 rounded-2xl border border-slate-100 hover:shadow-lg hover:border-blue-200 transition-all">
					<h3 class="text-lg font-bold mb-2 text-blue-700 group-hover:text-blue-800">Instalații Electrice Complete</h3>
					<p class="text-sm text-slate-600">Proiectare și execuție pentru case noi, apartamente și spații comerciale — conform normativului I7.</p>
					<span class="inline-block mt-3 text-blue-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Detalii →</span>
				</a>

				<a href={`${base}/servicii/tablouri-electrice-schneider/`} class="group bg-slate-50 p-6 rounded-2xl border border-slate-100 hover:shadow-lg hover:border-blue-200 transition-all">
					<h3 class="text-lg font-bold mb-2 text-blue-700 group-hover:text-blue-800">Tablouri Electrice Schneider</h3>
					<p class="text-sm text-slate-600">Montaj și configurare tablouri cu aparataj Schneider Electric — protecții RCD, SPD, disjunctoare calibrate.</p>
					<span class="inline-block mt-3 text-blue-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Detalii →</span>
				</a>

				<a href={`${base}/servicii/panouri-fotovoltaice/`} class="group bg-emerald-50 p-6 rounded-2xl border border-emerald-100 hover:shadow-lg hover:border-emerald-200 transition-all">
					<h3 class="text-lg font-bold mb-2 text-emerald-700 group-hover:text-emerald-800">Panouri Fotovoltaice</h3>
					<p class="text-sm text-slate-600">Sisteme fotovoltaice la cheie — devii prosumator și economisești mii de lei anual.</p>
					<span class="inline-block mt-3 text-emerald-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Detalii →</span>
				</a>

				<a href={`${base}/servicii/verificare-pram/`} class="group bg-slate-50 p-6 rounded-2xl border border-slate-100 hover:shadow-lg hover:border-blue-200 transition-all">
					<h3 class="text-lg font-bold mb-2 text-blue-700 group-hover:text-blue-800">Verificare PRAM</h3>
					<p class="text-sm text-slate-600">Buletin de verificare obligatoriu la vânzare imobil, racordare sau renovare majoră.</p>
					<span class="inline-block mt-3 text-blue-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Detalii →</span>
				</a>
			</div>
		</section>

		<section class="mb-16">
			<h2 class="text-3xl font-bold mb-6 text-slate-900">
				⚡ Depanări și Urgențe Electrice
			</h2>
			<p class="text-slate-600 mb-6">Intervenție rapidă în Iași și împrejurimi. Diagnosticăm și rezolvăm:</p>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
				<div class="bg-slate-50 p-4 rounded-xl border border-slate-100 text-center">
					<p class="font-bold text-sm text-slate-800">Diferențial / disjunctor</p>
				</div>
				<div class="bg-slate-50 p-4 rounded-xl border border-slate-100 text-center">
					<p class="font-bold text-sm text-slate-800">Lipsă curent parțială</p>
				</div>
				<div class="bg-slate-50 p-4 rounded-xl border border-slate-100 text-center">
					<p class="font-bold text-sm text-slate-800">Miros de ars</p>
				</div>
				<div class="bg-slate-50 p-4 rounded-xl border border-slate-100 text-center">
					<p class="font-bold text-sm text-slate-800">Tensiune mică</p>
				</div>
			</div>
		</section>

		<section class="mb-16 bg-slate-900 text-white p-8 md:p-10 rounded-3xl">
			<h2 class="text-2xl font-bold mb-6">🛡️ De ce AlexaVolt</h2>
			<div class="grid md:grid-cols-2 gap-6">
				<div>
					<h4 class="font-bold text-blue-400 mb-1">Autorizare ANRE Tip B</h4>
					<p class="text-slate-400 text-sm">Conformitate legală, documentație completă la recepție.</p>
				</div>
				<div>
					<h4 class="font-bold text-blue-400 mb-1">Transparență prețuri</h4>
					<p class="text-slate-400 text-sm">Deviz clar înainte de orice lucrare. Fără surprize.</p>
				</div>
				<div>
					<h4 class="font-bold text-blue-400 mb-1">Materiale Schneider Electric</h4>
					<p class="text-slate-400 text-sm">Protecții calibrate pe consumul real al locuinței.</p>
				</div>
				<div>
					<h4 class="font-bold text-blue-400 mb-1">Garanție 2 ani manoperă</h4>
					<p class="text-slate-400 text-sm">+ garanția producătorului pe materiale + buletin PRAM.</p>
				</div>
			</div>
		</section>

		<section class="mb-16">
			<h2 class="text-2xl font-bold mb-4 text-slate-900">
				📍 Zonă de acoperire
			</h2>
			<p class="text-slate-600 leading-relaxed">
				Iași și tot județul: Miroslava, Ciurea, Tomești, Valea Lupului, Copou, Bucium, Galata, Popricani, Rediu, Nicolina, CUG, Tătărași și toate cartierele. Rezidențial, comercial și industrial.
			</p>
		</section>

		<section class="text-center border-t border-slate-100 pt-12">
			<h2 class="text-2xl font-bold mb-4">Solicită evaluare gratuită</h2>
			<p class="mb-8 text-slate-600">Venim la fața locului, analizăm și oferim deviz detaliat — fără obligații.</p>
			<a 
				href={`${base}/contact/`} 
				class="inline-block bg-blue-600 text-white px-10 py-4 rounded-full text-lg font-bold hover:bg-blue-700 transition-all shadow-xl hover:-translate-y-1"
			>
				Contactează-ne acum
			</a>
		</section>

	</main>

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Electrician",
		"name": "AlexaVolt",
		"description": "Electrician autorizat ANRE Iași - instalații electrice profesionale, tablouri Schneider, sisteme fotovoltaice",
		"url": "https://www.alexavolt.ro",
		"telephone": "+40745539432",
		"email": "alexamarius@yahoo.com",
		"address": {
			"@type": "PostalAddress",
			"addressLocality": "Iași",
			"addressRegion": "Iași",
			"addressCountry": "RO"
		},
		"geo": {
			"@type": "GeoCoordinates",
			"latitude": 47.1585,
			"longitude": 27.6014
		},
		"areaServed": {
			"@type": "City",
			"name": "Iași"
		},
		"priceRange": "$$",
		"openingHours": "Mo-Fr 08:00-18:00, Sa 09:00-14:00",
		"sameAs": ["https://wa.me/40745539432"]
	})} />
</Layout>
