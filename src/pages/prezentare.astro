---
const newUrl = '/servicii/';
---
<!doctype html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <title>Redirect — AlexaVolt</title>
  <link rel="canonical" href={`https://www.alexavolt.ro${newUrl}`} />
  <meta http-equiv="refresh" content={`0;url=${newUrl}`} />
  <meta name="robots" content="noindex, follow" />
</head>
<body>
  <p>Pagina s-a mutat la <a href={newUrl}>noua adresă</a>.</p>
  <script define:vars={{newUrl}}>
    window.location.replace(newUrl);
  </script>
</body>
</html>
